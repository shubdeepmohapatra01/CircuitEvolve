 "rule": {
  "name": "kerr_half_pi_parity_phase_kickback_5op",
  "kind": "synth",
  "contract": "exact",
  "idea": "For every integer n, n^2 mod 4 depends only on parity, so exp(-i(pi/2) n^2) = e^{-i pi/4} exp(+i(pi/4) p) with p=(-1)^n, exactly on the whole Fock space. A clean ancilla picks up the parity via CR(pi) (phase kickback to |+>/|->), an rx diagonal in that basis applies the parity phase, and CR(-pi) cancels the residual mode phase and returns the ancilla to |0>. General theta = pi/2 + k*pi factors as R(k*pi) times this operator since (-1)^{k n^2} = (-1)^{k n}.",
  "term_kinds": [
   "n2"
  ],
  "stage": "logical"
 },
